{% extends "base.jinja2" %}

{% block title %}
Kollie environments
{% endblock title %}

{% block content %}
{% macro environment_row(environment) %}
<tr data-environment-name="{{ environment.name }}" data-owner-email="{{ environment.owner_email }}">
    <td>
        <a href="{{ relative_url_for('env_detail', testenv_name=environment.name) }}">{{
            environment.name }}</a>
        <span class="badge bg-secondary">{{ environment.owner_email }}</span>
        {% if environment.owner_email == userinfo.email %}
        ❤
        {% endif %}
    </td>
    <td>{{ environment.created_at | humanise }}</td>
    <td>
        <form method="post"
            action="{{ relative_url_for('delete_environment', testenv_name=environment.name) }}">
            <input class="btn btn-sm btn-outline-danger" type="submit" value="Delete">
        </form>
    </td>
</tr>
{% endmacro %}

{% macro environment_table(environments, empty_message, table_id=none) %}
<table class="table" {% if table_id %}id="{{ table_id }}"{% endif %}>
    <colgroup>
        <col style="width: 69%">
        <col style="width: 18%">
        <col style="width: 13%">
    </colgroup>
    <thead>
        {% if caller %}
        {{ caller() }}
        {% endif %}
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Created</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for environment in environments %}
        {{ environment_row(environment) }}
        {% else %}
        <tr>
            <td colspan="3">{{ empty_message }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endmacro %}

<div class="row">
    <div class="col mt-3">
        <h5 class="card-title float-start">My environments</h5>
        <a class="btn btn-dark float-end" href="{{relative_url_for('create_environment')}}"><i
                class="bi bi-folder-plus"></i> Create new environment</a>
    </div>
</div>

<div class="row">
    <div class="col mt-2">
        {% if my_environments is none %}
        {{ environment_table([], "Sign in to see your environments") }}
        {% else %}
        {{ environment_table(my_environments, "You have no running environments") }}
        {% endif %}
    </div>
</div>

<div class="row">
    <div class="col mt-3">
        <h5 class="card-title">All environments</h5>
    </div>
</div>

<div class="row">
    <div class="col mt-2">
        <form id="environment-search-form" method="get" action="{{ relative_url_for('environment_index') }}"
            role="search">
            {% if request.query_params.owner %}
            <input type="hidden" name="owner" value="{{ request.query_params.owner }}">
            {% endif %}
        </form>
        {% call environment_table(all_environments, "No running environments", table_id="all-environments-table") %}
        <tr>
            <td colspan="2" class="pb-3 border-0">
                <label class="visually-hidden" for="environment-search-input">Search environments</label>
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-secondary pe-none"
                        aria-hidden="true"></i>
                    <input id="environment-search-input" form="environment-search-form" class="form-control ps-5"
                        type="search" name="q" value="{{ search_term }}"
                        placeholder="Search by environment name or owner" autocomplete="off">
                </div>
            </td>
            <td class="pb-3 border-0">
                <button form="environment-search-form" class="btn btn-outline-secondary text-white"
                    type="submit">Search</button>
            </td>
        </tr>
        {% endcall %}
        <p id="environment-search-no-match" class="text-secondary d-none">No environments match your search</p>
    </div>
</div>

<script src="{{ url_for('static', path='/environment_search.js') }}"></script>
{% endblock content %}
